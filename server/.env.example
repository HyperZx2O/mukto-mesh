PORT=3000
NODE_ENV=development

# Admin panel password — CHANGE THIS BEFORE PRODUCTION
ADMIN_PASSWORD=changeme

# Twilio (optional — SMS alerts are mocked if not set)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Remote sync endpoint (Railway URL after deploy)
REMOTE_SYNC_URL=

# Database path (default: ./mukto_mesh.db)
DB_PATH=./mukto_mesh.db
